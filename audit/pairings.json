{
  "version": "1.0.0",
  "pairings": [
    {
      "id": "form-label",
      "fg": "{color.text.default}",
      "bg": "{color.bg.page}",
      "size": 14,
      "weight": "bold",
      "min": 4.5,
      "note": "Field label across form components — 14px bold Atkinson, Tier 2 Functional"
    },
    {
      "id": "form-required-asterisk",
      "fg": "{color.status.error-text}",
      "bg": "{color.bg.page}",
      "size": 14,
      "weight": "bold",
      "min": 4.5,
      "note": "Required marker (*) — inherits label size/weight; Tier 3 Supplementary (label text is the redundant channel)"
    },
    {
      "id": "form-input-value",
      "fg": "{color.text.default}",
      "bg": "{color.bg.page}",
      "size": 16,
      "weight": "regular",
      "min": 4.5,
      "note": "Typed value inside input/combobox/select — 16px regular, Tier 1 Reading"
    },
    {
      "id": "form-input-placeholder",
      "fg": "{color.text.disabled}",
      "bg": "{color.bg.page}",
      "size": 16,
      "weight": "regular",
      "min": 3.0,
      "exempt": "candor-supplementary",
      "note": "Placeholder text — no enforced floor: placeholder is supplementary and transient (real content replaces it on input) and is never the sole channel for meaning (the field carries a real label). min records the Tier-3 floor it would fall under if it were primary content. Measured OKCA ~1.7 light / ~1.9 dark on bg.page."
    },
    {
      "id": "form-input-disabled-value",
      "fg": "{color.text.disabled}",
      "bg": "{color.bg.surface}",
      "size": 16,
      "weight": "regular",
      "min": 3.0,
      "exempt": "wcag-1.4.3",
      "note": "Value text inside a disabled input — SC 1.4.3 exempts inactive components, so no floor is enforced; min records the Tier-3 floor it would fall under if active. Measured OKCA ~1.2 light / ~1.6 dark on bg.surface. Per the disabled-label convention (#134) the dim value signals 'unavailable'; the input's required disabled hint carries the actionable meaning."
    },
    {
      "id": "form-error-message",
      "fg": "{color.status.error-text}",
      "bg": "{color.bg.page}",
      "size": 16,
      "weight": "regular",
