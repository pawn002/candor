{
  "name": "@candor-design/tokens",
  "version": "5.0.1",
  "description": "Candor design tokens — CSS custom properties for a humanist design system built with OKLCH.",
  "main": "./tokens/candor-tokens.css",
  "module": "./tokens/candor-tokens.css",
  "style": "./tokens/candor-tokens.css",
  "exports": {
    ".": "./tokens/candor-tokens.css",
    "./candor-tokens.css": "./tokens/candor-tokens.css",
    "./candor-tokens.min.css": "./tokens/candor-tokens.min.css",
    "./candor-tokens.json": "./tokens/candor-tokens.json",
    "./candor-fonts.css": "./tokens/candor-fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:playwright": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:playwright:ui": "playwright test --ui",
    "build:tokens": "node scripts/build-tokens.js",
    "build:wc": "vite build --config vite.wc.config.ts && vite build --config vite.tone-data.config.ts",
    "version": "node scripts/sync-wc-version.js && git add web-components/package.json",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --only-changed",
    "chromatic:trace": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --only-changed --dry-run --debug --trace-changed",
    "audit:tokens": "node scripts/export-tokens-dtcg.js",
    "audit:contrast": "node scripts/check-contrast.js",
    "audit:packaging": "node scripts/check-package-deps.js",
    "audit:docs": "node scripts/check-docs-claims.js",
    "build:cem": "cem analyze"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawn002/candor.git"
  },
  "keywords": [],
  "author": "John Z. Rioflorido",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pawn002/candor/issues"
  },
  "homepage": "https://main--69c25e2492ad056c24329876.chromatic.com",
  "overrides": {
    "chokidar": "^5.0.0",
    "readdirp": "^4.0.0",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@fontsource-variable/noto-serif": "^5.2.9",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource-variable/roboto-mono": "^5.2.8",
    "@fontsource/atkinson-hyperlegible": "^5.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@phosphor-icons/web": "^2.1.2",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-themes": "^10.5.6",
    "@storybook/web-components-vite": "^10.5.6",
    "@types/node": "^24.13.3",
    "chromatic": "^18.0.1",
    "culori": "^4.0.2",
    "lit": "^3.3.2",
    "sass": "^1.101.0",
    "storybook": "^10.5.6",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  },
  "customElements": "web-components/custom-elements.json"
}
