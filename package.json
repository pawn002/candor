{
  "name": "@candor-design/tokens",
  "version": "4.1.0",
  "description": "Candor design tokens — CSS custom properties for a humanist design system built with OKLCH.",
  "files": [
    "tokens"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "test-storybook": "test-storybook",
    "build-storybook": "storybook build",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "build:tokens": "node scripts/build-tokens.js",
    "build:wc": "vite build --config vite.wc.config.ts && vite build --config vite.tone-data.config.ts",
    "version": "npm --prefix web-components version $npm_package_version --no-git-tag-version --allow-same-version && git add web-components/package.json",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "audit:tokens": "node scripts/export-tokens-dtcg.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawn002/candor.git"
  },
  "keywords": [],
  "author": "John Z. Rioflorido",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pawn002/candor/issues"
  },
  "homepage": "https://github.com/pawn002/candor#readme",
  "overrides": {
    "chokidar": "^5.0.0",
    "readdirp": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@fontsource-variable/noto-serif": "^5.2.9",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource-variable/roboto-mono": "^5.2.8",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@standard-schema/spec": "^1.0.0",
    "culori": "^4.0.2",
    "lit": "^3.3.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@phosphor-icons/web": "^2.1.2",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-themes": "^10.3.1",
    "@storybook/test-runner": "^0.24.2",
    "@storybook/web-components-vite": "^10.4.4",
    "chromatic": "^16.0.0",
    "sass": "^1.101.0",
    "storybook": "^10.1.4",
    "vite": "^7.3.2",
    "vite-plugin-dts": "^5.0.0"
  }
}
